# ==========================================
# LATIDOS COMPARTIDOS - VARIABLES DE ENTORNO
# ==========================================

# Puerto del Servidor Backend (Render / Railway / Local)
PORT=3001

# URL del Cliente Frontend (para CORS en producción, ej: https://latidos-compartidos.vercel.app o *)
CLIENT_URL=*

# URL del Backend para el Frontend (Vite)
# En local déjalo vacío o http://localhost:3001
# En producción en Vercel, coloca la URL de tu backend en Render/Railway:
# VITE_BACKEND_URL=https://tu-backend-latidos.onrender.com
VITE_BACKEND_URL=http://localhost:3001

# Pulsoid Access Token por defecto (opcional, también se configura desde la app)
# PULSOID_TOKEN=tu-token-aqui
